{% if todays %}
<h2>Today's Birthdays</h2>
{% for name, birthday in todays %}
{{ name }}
{% if 'year' in birthday %}
    ({{ year - birthday['year'] }})
{% endif %}
<br />
{% endfor %}
{% endif %}

{% if this_months %}
<h2>This Month</h2>
<table>
    {% for name, birthday in this_months %}
    <tr><td>{{ name }}</td>
        <td>{{ birthday['month'] }}/{{ birthday['day'] }}</td>
        {% if 'year' in birthday %}
        <td>({{ year - birthday['year'] }})</td>
        {% endif %}
    </tr>
    {% endfor %}
</table>
{% endif %}
